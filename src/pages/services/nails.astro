---
import ServicePage from '../../components/salon-services/ServicePage.astro';
import { nailFAQs } from '../../data/faqs';

const title = "Nail Salon in Carmel, IN | Gel, Dip, Manicures & Pedicures | Glow Salon & Spa";
const description = "Nail salon in Carmel, IN for manicures, gel manicures, dip nails, classic pedicures, and spa pedicures at Glow Salon & Spa in the Village of West Clay.";

const nail_services = [
    { serviceName: "Manicure", price: "$30" },
    { serviceName: "Gel Manicure", price: "$50" },
    { serviceName: "Dip Manicure", price: "$60" },
    { serviceName: "Spa Pedicure", price: "$65" },
    { serviceName: "Classic Pedicure", price: "$55" }
]
---

<ServicePage 
    title={title}
    description={description}
    pageTitle="Nail Salon in Carmel, IN"
    introText="Visit Glow Salon & Spa in the Village of West Clay for professional manicures, pedicures, gel manicures, and dip nails. Located in Carmel, Indiana, our nail services are convenient for clients from Westfield, Zionsville, Fishers, Noblesville, and northwest Indianapolis."
    services={nail_services}
    faqs={nailFAQs}
>
    <section slot="introDetails" class="service-detail-grid" aria-labelledby="nails-west-clay-heading">
        <div>
            <h2 id="nails-west-clay-heading">West Clay nails, manicures, and pedicures</h2>
            <p>
                If you are searching for a nail salon near Carmel or West Clay nails, Glow Salon &amp; Spa
                offers classic manicures, gel manicures, dip manicures, classic pedicures, and spa pedicures
                in a relaxed full-service salon setting.
            </p>
        </div>
        <div>
            <h2>Popular Nail Appointments</h2>
            <ul>
                <li><a href="#gel-manicure">Gel manicures</a></li>
                <li><a href="#dip-manicure">Dip manicures</a></li>
                <li><a href="#spa-pedicure">Spa pedicures</a></li>
                <li><a href="/blog/gel-vs-dip-nails-carmel/">Gel vs. dip nail guide</a></li>
            </ul>
        </div>
    </section>

    <section class="blog-links-section">
        <h2 class="blog-links-heading">From Our Blog</h2>
        <ul class="blog-links-list">
            <li><a href="/blog/gel-vs-dip-nails-carmel/">Gel vs. Dip Nails: Which Is Right for You?</a></li>
            <li><a href="/blog/best-spa-services-carmel-indiana/">What to Expect at a Spa in Carmel, Indiana</a></li>
        </ul>
    </section>

    <section class="related-services-section">
        <h2 class="related-heading">Related Services</h2>
        <ul class="related-list">
            <li><a href="/services/hair/">Hair Services - Cuts, Color &amp; Balayage</a></li>
            <li><a href="/services/waxing-carmel-in/">Waxing Services</a></li>
            <li><a href="/services/makeup/">Makeup Services</a></li>
            <li><a href="/services/bridal/">Bridal Hair &amp; Makeup Packages</a></li>
        </ul>
    </section>
</ServicePage>

<style>
    .blog-links-section,
    .related-services-section {
        max-width: 720px;
        margin: 0 auto 3rem;
        padding: 2rem;
        border-top: 1px solid var(--blush);
    }

    .blog-links-heading,
    .related-heading {
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        font-size: 1.4rem;
        font-weight: 300;
        color: var(--deep);
        margin: 0 0 1rem;
    }

    .blog-links-list,
    .related-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .blog-links-list li,
    .related-list li {
        margin-bottom: 0.6rem;
    }

    .blog-links-list a,
    .related-list a {
        font-family: 'Jost', sans-serif;
        font-size: 0.9rem;
        font-weight: 300;
        color: var(--rose);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .blog-links-list a:hover,
    .related-list a:hover {
        color: var(--deep);
    }
</style>
