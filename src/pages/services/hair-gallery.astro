---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import StructuredData from '../../components/SEO/StructuredData.astro';
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import { BUSINESS_INFO } from '../../config/constants';

import blondeBalayageWaves from '../../assets/hair/blonde-balayage-wavy-long-2.webp';
import darkBrunetteWaves from '../../assets/hair/dark-brunette-long-waves-2.webp';
import darkBrunetteLongWaves from '../../assets/hair/dark-brunette-long-waves.webp';
import img1 from '../../assets/hair/IMG_5164.webp';
import img2 from '../../assets/hair/IMG_5380.webp';
import img4 from '../../assets/hair/IMG_5466.webp';
import img5 from '../../assets/hair/IMG_5502.webp';
import img6 from '../../assets/hair/IMG_2127.webp';
import img7 from '../../assets/hair/IMG_2130.webp';
import img8 from '../../assets/hair/IMG_3721.webp';

const title = 'Hair Lookbook – Cuts, Color & Styling | Glow Salon & Spa';
const description = 'Explore real haircuts, balayage, dimensional color, highlights, and styling created by the Glow Salon & Spa team in Carmel, Indiana.';

const galleryImages = [
  { src: blondeBalayageWaves, alt: 'Dimensional blonde balayage with long waves by Glow Salon & Spa in Carmel, Indiana', title: 'Dimensional blonde', detail: 'Balayage + soft waves' },
  { src: darkBrunetteWaves, alt: 'Long dark brunette layers styled in soft waves at Glow Salon & Spa', title: 'Rich brunette', detail: 'Gloss + long layers' },
  { src: darkBrunetteLongWaves, alt: 'Glossy dark brunette hair with long polished waves by a Carmel hairstylist', title: 'Polished waves', detail: 'Deep tone + shine' },
  { src: img1, alt: 'Professional haircut and styling by Glow Salon & Spa in Carmel, Indiana', title: 'Fresh shape', detail: 'Cut + finish' },
  { src: img2, alt: 'Balayage hair color by Glow Salon stylists in Carmel, Indiana', title: 'Lived-in color', detail: 'Dimensional color' },
  { src: img4, alt: 'Highlights and blowout styling by Glow Salon & Spa', title: 'Bright dimension', detail: 'Highlights + blowout' },
  { src: img5, alt: 'Professional hair styling at Glow Salon & Spa in Carmel, Indiana', title: 'Soft movement', detail: 'Style + finish' },
  { src: img6, alt: 'Hair coloring services by Glow Salon & Spa in Carmel, Indiana', title: 'Tonal detail', detail: 'Color + gloss' },
  { src: img7, alt: 'Haircut and style by Glow Salon & Spa stylists', title: 'Modern texture', detail: 'Cut + style' },
  { src: img8, alt: 'Hair services at Glow Salon & Spa in Carmel, Indiana', title: 'The finished look', detail: 'Styled at Glow' },
];

const imageGallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Hair Services Gallery - Glow Salon & Spa',
  description,
  url: `${BUSINESS_INFO.website}/services/hair-gallery`,
  creator: { '@type': 'BeautySalon', name: BUSINESS_INFO.name },
};
---

<Layout title={title} description={description}>
  <StructuredData data={imageGallerySchema} />
  <Breadcrumbs items={[
    { name: 'Home', url: BUSINESS_INFO.website },
    { name: 'Services', url: `${BUSINESS_INFO.website}/services` },
    { name: 'Hair', url: `${BUSINESS_INFO.website}/services/hair` },
    { name: 'Gallery', url: `${BUSINESS_INFO.website}/services/hair-gallery` },
  ]} />
  <PortfolioGallery
    eyebrow="The Hair Edit"
    heading="Color, cuts & good hair days."
    intro="A collection of real looks created in our Carmel salon, from subtle dimension and glossy brunettes to fresh cuts and event-ready styling."
    backHref="/services/hair/"
    backLabel="Back to Hair Services"
    images={galleryImages}
    ctaText="See something that feels like you?"
    ctaHref="/services/hair/"
    ctaLabel="View services & book"
  />
</Layout>
