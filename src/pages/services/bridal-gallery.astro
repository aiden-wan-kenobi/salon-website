---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import StructuredData from '../../components/SEO/StructuredData.astro';
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import { BUSINESS_INFO } from '../../config/constants';

import auburnHollywoodWaves from '../../assets/bridal/auburn-hollywood-waves-soft-glam.webp';
import blondeSideSweptCurls from '../../assets/bridal/blonde-side-swept-curls-soft-glam.webp';
import brideTiaraPortrait from '../../assets/bridal/bride-updo-tiara-portrait.webp';
import bridalHalfUpWavesBack from '../../assets/bridal/bridal-half-up-waves-back.webp';
import bridalHalfUpWavesFront from '../../assets/bridal/bridal-half-up-waves-front.webp';
import bridesmaidLowUpdo from '../../assets/bridal/bridesmaid-low-updo.webp';
import brideTiaraGlamour from '../../assets/bridal/bride-updo-tiara-glamour.webp';
import brunetteLowPonytail from '../../assets/bridal/brunette-low-ponytail-big-curls.webp';
import brunetteTexturedUpdo from '../../assets/bridal/brunette-textured-updo.webp';
import blondeCasualUpdo from '../../assets/bridal/blonde-casual-updo.webp';
import brunetteMessyBun from '../../assets/bridal/brunette-messy-bun.webp';
import brunetteHalfUpFormal from '../../assets/bridal/brunette-halfup-braided-formal.webp';
import brunetteBraidedUpdo from '../../assets/bridal/brunette-braided-updo.webp';
import brunetteLowBraidedBun from '../../assets/bridal/brunette-low-bun-braided.webp';
import img1 from '../../assets/bridal/20250709_215524_272BE9.webp';
import img2 from '../../assets/bridal/IMG_0951_18rs.webp';
import img3 from '../../assets/bridal/IMG_1747rs.webp';
import img4 from '../../assets/bridal/IMG_3583.webp';
import img5 from '../../assets/bridal/IMG_3704rs.webp';
import img6 from '../../assets/bridal/KAD_7303rs.webp';
import img7 from '../../assets/bridal/bridal-half-up-soft-waves.webp';
import img8 from '../../assets/bridal/bridal-pearl-floral-hairpiece.webp';
import img9 from '../../assets/bridal/bridal-floral-hairpiece-curls.webp';
import img10 from '../../assets/bridal/bridal-braided-soft-curls.webp';
import img11 from '../../assets/bridal/bridal-half-up-highlighted-curls.webp';

const title = 'Bridal Lookbook – Wedding Hair & Makeup | Glow Salon & Spa';
const description = 'Explore real bridal updos, half-up styles, soft waves, and wedding makeup by Glow Salon & Spa in Carmel, Indiana.';

const galleryImages = [
  { src: auburnHollywoodWaves, alt: 'Auburn bridal hairstyle with glossy Hollywood waves and soft-glam makeup by Glow Salon & Spa in Carmel, Indiana', title: 'Auburn glamour', detail: 'Hollywood waves + soft glam' },
  { src: blondeSideSweptCurls, alt: 'Blonde bridal hairstyle with voluminous side-swept curls and soft-glam makeup by Glow Salon & Spa in Carmel, Indiana', title: 'Swept-away volume', detail: 'Side-swept curls + soft glam' },
  { src: brideTiaraPortrait, alt: 'Bride with tiara, elegant updo, and soft-glam wedding makeup by Glow Salon & Spa in Carmel, Indiana', title: 'Modern romance', detail: 'Tiara updo + soft glam' },
  { src: bridalHalfUpWavesFront, alt: 'Bride with half-up soft waves and polished bridal makeup by Glow Salon & Spa in Carmel, Indiana', title: 'Softly polished', detail: 'Half-up waves + makeup' },
  { src: bridalHalfUpWavesBack, alt: 'Back view of half-up bridal waves styled by Glow Salon & Spa in Carmel, Indiana', title: 'The back detail', detail: 'Half-up soft waves' },
  { src: bridesmaidLowUpdo, alt: 'Polished bridesmaid low updo with dimensional highlights and face-framing curls', title: 'Effortless updo', detail: 'Textured low bun' },
  { src: brideTiaraGlamour, alt: 'Soft-glam bridal makeup and tiara updo for an Indiana wedding', title: 'A little sparkle', detail: 'Tiara + soft glam' },
  { src: brunetteLowPonytail, alt: 'Sleek brunette bridal ponytail with voluminous curls by Glow Salon & Spa', title: 'Statement pony', detail: 'Volume + polished curls' },
  { src: brunetteTexturedUpdo, alt: 'Textured brunette wedding updo with soft face-framing pieces', title: 'Soft texture', detail: 'Romantic updo' },
  { src: blondeCasualUpdo, alt: 'Soft blonde low bun styled for a wedding by Glow Salon & Spa', title: 'Undone elegance', detail: 'Soft low bun' },
  { src: brunetteMessyBun, alt: 'Voluminous brunette updo with loose curls for a formal event', title: 'Airy volume', detail: 'Loose formal updo' },
  { src: brunetteHalfUpFormal, alt: 'Formal half-up brunette hairstyle with long curls by Glow Salon & Spa', title: 'Classic half-up', detail: 'Long formal curls' },
  { src: brunetteBraidedUpdo, alt: 'Brunette half-up wedding hairstyle with twisted detail and soft curls', title: 'Braided detail', detail: 'Texture + soft curls' },
  { src: brunetteLowBraidedBun, alt: 'Brunette low wedding bun with braided detail and soft curls', title: 'Braided low bun', detail: 'Romantic detail' },
  { src: img1, alt: 'Bridal hair styling with elegant waves by Glow Salon & Spa in Carmel, Indiana', title: 'Wedding waves', detail: 'Elegant styling' },
  { src: img2, alt: 'Wedding day updo and bridal makeup by Glow Salon stylists', title: 'The full look', detail: 'Hair + makeup' },
  { src: img3, alt: 'Bride getting ready with professional hair and makeup in Carmel, Indiana', title: 'Getting ready', detail: 'Wedding morning' },
  { src: img4, alt: 'Bridal party hair styling at Glow Salon & Spa serving Carmel, Westfield, and Fishers', title: 'For the whole party', detail: 'Bridal party styling' },
  { src: img5, alt: 'Professional bridal hairstyle for an Indiana wedding by Glow Salon & Spa', title: 'Lasting finish', detail: 'Wedding styling' },
  { src: img6, alt: 'Wedding hair and makeup services in Carmel, Indiana by Glow Salon & Spa', title: 'Ready to celebrate', detail: 'Hair + makeup' },
  { src: img7, alt: 'Half-up bridal hairstyle with soft waves by Glow Salon & Spa in Carmel, Indiana', title: 'Soft half-up', detail: 'Relaxed waves' },
  { src: img8, alt: 'Bridal curls with pearl and floral hairpiece by Glow Salon & Spa', title: 'Pearl details', detail: 'Hairpiece + curls' },
  { src: img9, alt: 'Wedding hairstyle with floral hairpiece and soft curls by Glow Salon & Spa', title: 'Fresh florals', detail: 'Hairpiece + soft curls' },
  { src: img10, alt: 'Loose braided bridal hairstyle with soft curls by Glow Salon & Spa', title: 'Loose braid', detail: 'Soft bridal curls' },
  { src: img11, alt: 'Half-up highlighted bridal curls styled by Glow Salon & Spa in Carmel, Indiana', title: 'Highlighted curls', detail: 'Half-up styling' },
];

const imageGallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Bridal Hair & Makeup Gallery - Glow Salon & Spa',
  description,
  url: `${BUSINESS_INFO.website}/services/bridal-gallery`,
  creator: { '@type': 'BeautySalon', name: BUSINESS_INFO.name },
};
---

<Layout title={title} description={description}>
  <StructuredData data={imageGallerySchema} />
  <Breadcrumbs items={[
    { name: 'Home', url: BUSINESS_INFO.website },
    { name: 'Services', url: `${BUSINESS_INFO.website}/services` },
    { name: 'Bridal', url: `${BUSINESS_INFO.website}/services/bridal` },
    { name: 'Gallery', url: `${BUSINESS_INFO.website}/services/bridal-gallery` },
  ]} />
  <PortfolioGallery
    eyebrow="The Bridal Edit"
    heading="Real brides, beautiful moments."
    intro="A closer look at wedding hair and makeup created by our team, from relaxed waves and softly textured updos to polished glam that still feels like you."
    backHref="/services/bridal/"
    backLabel="Back to Bridal Services"
    images={galleryImages}
    ctaText="Have a look in mind for your day?"
    ctaHref="/services/bridal/"
    ctaLabel="Explore bridal services"
  />
</Layout>
