---
import ServicePage from '../../components/salon-services/ServicePage.astro';
import { hairColorFAQs } from '../../data/faqs';

const title = "Hair Color in Carmel, IN | Highlights, Gloss & Dimensional Color | Glow Salon & Spa";
const description = "Hair color in Carmel, IN for highlights, dimensional color, glosses, glazes, gray coverage, and balayage consultations at Glow Salon & Spa in the Village of West Clay.";

const colorServices = [
  { serviceName: "Full Highlight w/Blow-dry", price: "Starting at $150" },
  { serviceName: "Partial Highlight w/Blow-dry", price: "Starting at $135" },
  { serviceName: "Full Highlight w/Haircut", price: "Starting at $185" },
  { serviceName: "Partial Highlight w/Haircut", price: "Starting at $165" },
  { serviceName: "Dimensional Color w/Blow-dry", price: "Starting at $140" },
  { serviceName: "Dimensional Color w/Haircut", price: "Starting at $165" },
  { serviceName: "All Over Color w/Blowout", price: "$130" },
  { serviceName: "All Over Color w/Haircut", price: "$150" },
  { serviceName: "New Growth Touch-up w/Blow-dry", price: "$110" },
  { serviceName: "New Growth Touch-up w/Haircut", price: "$140" },
  { serviceName: "Color Glaze w/Blow-dry", price: "$70" },
  { serviceName: "Color Glaze w/Haircut", price: "$105" },
  { serviceName: "Balayage", price: "Priced upon consultation" },
];
---

<ServicePage
  title={title}
  description={description}
  pageTitle="Hair Color in Carmel, IN"
  introText="Glow Salon & Spa offers hair color, highlights, dimensional color, color glazes, gray coverage, and balayage consultations in Carmel's Village of West Clay. If you are searching for hair color near me, highlights near me, or a low-maintenance Carmel color specialist, our stylists can help you choose the right service for your hair and schedule."
  services={colorServices}
  faqs={hairColorFAQs}
  galleryHeading="Our Hair Color Work"
  gallerySubtext="Highlights, dimensional color, and finished styles from the Glow team"
  galleryUrl="/services/hair-gallery/"
>
  <section slot="introDetails" class="service-detail-grid" aria-labelledby="color-options-heading">
    <div>
      <h2 id="color-options-heading">Highlights, glosses, gray coverage, and lived-in color</h2>
      <p>
        Color appointments are customized to your starting point, maintenance goals, and desired
        brightness. Choose highlights for visible lift, dimensional color for depth and movement,
        all-over color for an even refresh, or a color glaze for shine and tone between bigger visits.
      </p>
    </div>
    <div>
      <h2>Best-Fit Color Services</h2>
      <ul>
        <li><a href="#dimensional-color-w-blow-dry">Dimensional color for soft grow-out</a></li>
        <li><a href="#full-highlight-w-blow-dry">Full highlights for brighter blonde</a></li>
        <li><a href="#partial-highlight-w-blow-dry">Partial highlights for face-framing brightness</a></li>
        <li><a href="#color-glaze-w-blow-dry">Color glaze for shine and tone</a></li>
      </ul>
    </div>
  </section>

  <section class="blog-links-section">
    <h2 class="blog-links-heading">Color Guides</h2>
    <ul class="blog-links-list">
      <li><a href="/blog/low-maintenance-hair-color-carmel/">Best Low-Maintenance Hair Colors for Busy Schedules</a></li>
      <li><a href="/blog/dimensional-hair-color-carmel-indiana/">Dimensional Hair Color in Carmel, Indiana</a></li>
      <li><a href="/blog/how-to-keep-hair-color-lasting-longer/">How to Make Your Hair Color Last Longer Between Visits</a></li>
      <li><a href="/blog/spring-2026-hair-color-trends-indianapolis/">Spring 2026 Hair Color Trends</a></li>
    </ul>
  </section>

  <section class="related-services-section">
    <h2 class="related-heading">Related Services</h2>
    <ul class="related-list">
      <li><a href="/services/hair/">All Hair Services</a></li>
      <li><a href="/services/haircuts-carmel-in/">Haircuts and Blowouts</a></li>
      <li><a href="/hair-salon-carmel-in/">Hair Salon in Carmel, Indiana</a></li>
    </ul>
  </section>
</ServicePage>

<style>
  .blog-links-section,
  .related-services-section {
    max-width: 720px;
    margin: 0 auto 3rem;
    padding: 2rem;
    border-top: 1px solid var(--blush);
  }

  .blog-links-heading,
  .related-heading {
    font-family: 'Cormorant Garamond', 'Georgia', serif;
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--deep);
    margin: 0 0 1rem;
  }

  .blog-links-list,
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blog-links-list li,
  .related-list li {
    margin-bottom: 0.6rem;
  }

  .blog-links-list a,
  .related-list a {
    font-family: 'Jost', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--rose);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-links-list a:hover,
  .related-list a:hover {
    color: var(--deep);
  }
</style>
