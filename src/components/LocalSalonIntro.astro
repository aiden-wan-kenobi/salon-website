---
/**
 * LocalSalonIntro component
 * Single Responsibility: Summarize local salon intent and route users to core service pages
 */
---

<section class="local-intent" aria-labelledby="local-intent-heading">
  <div class="local-intent-inner">
    <div>
      <p class="section-eyebrow">Village of West Clay</p>
      <h2 id="local-intent-heading">A Carmel hair salon for color, cuts, nails, waxing, and bridal beauty</h2>
    </div>
    <div class="local-intent-copy">
      <p>
        Looking for a hair salon near Carmel, IN? Glow Salon &amp; Spa offers haircuts,
        dimensional color, highlights, glosses, nails, brow waxing, lip waxing, makeup,
        and bridal styling at 1928 Rhettsbury St in the Village of West Clay.
      </p>
      <div class="local-intent-links" aria-label="Popular local salon services">
        <a href="/hair-salon-carmel-in/">Hair Salon in Carmel</a>
        <a href="/services/hair-color-carmel-in/">Hair Color</a>
        <a href="/services/haircuts-carmel-in/">Haircuts</a>
        <a href="/services/nails/">Nails</a>
        <a href="/services/waxing-carmel-in/">Waxing</a>
      </div>
    </div>
  </div>
</section>

<style>
  .local-intent {
    background: var(--cream);
    padding: 4.5rem 2rem;
  }

  .local-intent-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: start;
  }

  .section-eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose);
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 3vw, 2.65rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--deep);
    margin: 0;
  }

  .local-intent-copy p {
    font-family: 'Jost', sans-serif;
    font-size: 0.98rem;
    font-weight: 300;
    color: var(--warm-gray);
    line-height: 1.8;
    margin: 0 0 1.5rem;
  }

  .local-intent-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .local-intent-links a {
    border: 1px solid var(--blush);
    color: var(--deep);
    font-family: 'Jost', sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.7rem 1rem;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .local-intent-links a:hover {
    background: #fff;
    border-color: var(--rose);
    color: var(--rose);
  }

  @media (max-width: 820px) {
    .local-intent {
      padding: 3rem 1.25rem;
    }

    .local-intent-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
