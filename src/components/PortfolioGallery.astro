---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  title: string;
  detail?: string;
  layout?: 'feature' | 'tall' | 'standard' | 'wide' | 'compact';
}

export interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  backHref: string;
  backLabel: string;
  images: GalleryImage[];
  ctaText: string;
  ctaHref: string;
  ctaLabel: string;
}

const {
  eyebrow,
  heading,
  intro,
  backHref,
  backLabel,
  images,
  ctaText,
  ctaHref,
  ctaLabel,
} = Astro.props;

const layoutClasses = ['feature', 'tall', 'standard', 'wide', 'standard', 'tall', 'wide'];
---

<section class="portfolio" aria-labelledby="portfolio-heading">
  <div class="portfolio-intro">
    <a href={backHref} class="back-link">
      <span aria-hidden="true">&larr;</span>
      {backLabel}
    </a>
    <p class="eyebrow">{eyebrow}</p>
    <div class="intro-grid">
      <h1 id="portfolio-heading">{heading}</h1>
      <p>{intro}</p>
    </div>
  </div>

  <p class="gallery-note">
    <span aria-hidden="true">✦</span>
    Click any print for a closer look
  </p>

  <ul class="lookbook" aria-label={`${heading} photos`}>
    {images.map((image, index) => {
      const layout = image.layout ?? layoutClasses[index % layoutClasses.length];

      return (
        <li class:list={['look-wrap', layout]}>
          <button
            class="look"
            type="button"
            data-gallery-item
            data-index={index}
            data-full-src={image.src.src}
            aria-label={`Open ${image.title} in full screen`}
          >
            <span class="photo-frame">
              <Image
                src={image.src}
                alt={image.alt}
                class="look-image"
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding={index < 3 ? 'sync' : 'async'}
                fetchpriority={index < 3 ? 'high' : 'auto'}
                widths={[320, 480, 680, 960]}
                sizes="(max-width: 800px) 50vw, 33vw"
                quality={86}
              />
              <span class="expand-icon" aria-hidden="true">+</span>
            </span>
            <span class="look-caption">
              <strong>{image.title}</strong>
              {image.detail && <span>{image.detail}</span>}
            </span>
          </button>
        </li>
      );
    })}
  </ul>

  <div class="portfolio-cta">
    <p>{ctaText}</p>
    <a href={ctaHref} class="cta-link">
      {ctaLabel}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Expanded gallery image">
  <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close image viewer">&times;</button>
  <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Previous image">&larr;</button>
  <figure>
    <img data-lightbox-image src="" alt="" />
    <figcaption>
      <strong data-lightbox-title></strong>
      <span data-lightbox-detail></span>
    </figcaption>
  </figure>
  <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Next image">&rarr;</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
  const lightboxImage = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const lightboxTitle = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const lightboxDetail = dialog?.querySelector<HTMLElement>('[data-lightbox-detail]');
  let activeIndex = 0;

  const showImage = (index: number) => {
    if (!dialog || !lightboxImage || !lightboxTitle || !lightboxDetail || items.length === 0) return;
    activeIndex = (index + items.length) % items.length;
    const item = items[activeIndex];
    const image = item.querySelector<HTMLImageElement>('img');
    const title = item.querySelector<HTMLElement>('.look-caption strong');
    const detail = item.querySelector<HTMLElement>('.look-caption span');
    if (!image || !title) return;

    lightboxImage.src = item.dataset.fullSrc ?? image.currentSrc ?? image.src;
    lightboxImage.alt = image.alt;
    lightboxTitle.textContent = title.textContent;
    lightboxDetail.textContent = detail?.textContent ?? '';
  };

  items.forEach((item, index) => {
    item.addEventListener('click', () => {
      showImage(index);
      dialog?.showModal();
      document.body.classList.add('lightbox-open');
    });
  });

  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => showImage(activeIndex - 1));
  dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => showImage(activeIndex + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => document.body.classList.remove('lightbox-open'));
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showImage(activeIndex - 1);
    if (event.key === 'ArrowRight') showImage(activeIndex + 1);
  });
</script>

<style>
  .portfolio {
    position: relative;
    overflow: hidden;
    padding: 3rem 2rem 6rem;
    background:
      linear-gradient(rgba(254, 250, 245, 0.94), rgba(247, 239, 232, 0.96)),
      repeating-linear-gradient(0deg, transparent 0 27px, rgba(138, 120, 114, 0.11) 27px 28px);
  }

  .portfolio::before,
  .portfolio::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(201, 160, 144, 0.18);
    border-radius: 50%;
    pointer-events: none;
  }

  .portfolio::before { top: -180px; right: -80px; }
  .portfolio::after { bottom: -190px; left: -100px; }

  .portfolio-intro,
  .gallery-note,
  .lookbook,
  .portfolio-cta {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin-inline: auto;
  }

  .portfolio-intro { padding: 1.5rem 0 3rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 3.5rem;
    color: var(--warm-gray);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .back-link:hover,
  .back-link:focus-visible { color: var(--rose); }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: var(--rose);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 4rem;
    align-items: end;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    font-weight: 300;
    line-height: 0.96;
  }

  .intro-grid > p {
    max-width: 430px;
    margin: 0;
    color: var(--warm-gray);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
  }

  .gallery-note {
    margin-bottom: 1rem;
    color: var(--warm-gray);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-align: right;
    text-transform: uppercase;
  }

  .gallery-note span { margin-right: 0.35rem; color: var(--rose); }

  .lookbook {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 1.75rem 1.65rem;
    margin-top: 0;
    margin-bottom: 0;
    padding: 2.25rem 2rem 0.6rem;
    list-style: none;
    background-color: #d8b8a9;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px),
      radial-gradient(circle at 80% 70%, rgba(61, 43, 35, 0.08) 0 1px, transparent 1px);
    background-size: 13px 13px, 17px 17px;
    box-shadow: inset 0 0 70px rgba(61, 43, 35, 0.1);
  }

  .look-wrap {
    --tilt: -0.75deg;
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    transform: rotate(var(--tilt));
    transition: transform 0.3s ease, z-index 0s;
  }

  .look-wrap:nth-child(3n + 2) { --tilt: 0.9deg; }
  .look-wrap:nth-child(5n + 3) { --tilt: -1.25deg; }
  .look-wrap:nth-child(7n) { --tilt: 1.35deg; }

  .look-wrap:hover,
  .look-wrap:focus-within {
    z-index: 3;
    transform: rotate(0deg) translateY(-5px);
  }

  .look {
    position: relative;
    display: block;
    width: 100%;
    border: 0;
    padding: 0.68rem 0.68rem 0.8rem;
    background: #fffdfa;
    color: var(--deep);
    box-shadow: 0 9px 22px rgba(61, 43, 35, 0.2);
    cursor: zoom-in;
    text-align: left;
    transition: box-shadow 0.3s ease;
  }

  .look::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(61, 43, 35, 0.05);
    pointer-events: none;
  }

  .look-wrap:nth-child(5n + 1) .look::after,
  .look-wrap:nth-child(8n + 4) .look::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: -12px;
    left: 50%;
    width: 72px;
    height: 24px;
    background: rgba(239, 220, 185, 0.78);
    box-shadow: 0 1px 2px rgba(61, 43, 35, 0.1);
    transform: translateX(-50%) rotate(-2deg);
    backdrop-filter: blur(1px);
  }

  .look-wrap:nth-child(8n + 4) .look::after { transform: translateX(-50%) rotate(3deg); }

  .look:hover,
  .look:focus-visible { box-shadow: 0 18px 34px rgba(61, 43, 35, 0.28); }

  .look:focus-visible { outline: 3px solid var(--deep); outline-offset: 4px; }

  .photo-frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #eadfd7;
  }

  .look-wrap.tall .photo-frame { aspect-ratio: 3 / 4; }
  .look-wrap.wide .photo-frame { aspect-ratio: 4 / 3; }
  .look-wrap.compact .photo-frame { aspect-ratio: 1 / 1; }
  .look-wrap.feature .photo-frame { aspect-ratio: 4 / 5; }

  .look-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.94) contrast(0.99);
    transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.3s ease;
  }

  .look:hover .look-image,
  .look:focus-visible .look-image {
    transform: scale(1.03);
    filter: saturate(1) contrast(1);
  }

  .look-caption {
    display: block;
    min-height: 42px;
    padding: 0.7rem 0.22rem 0;
  }

  .look-caption strong,
  .look-caption span { display: block; }

  .look-caption strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .look-caption span {
    margin-top: 0.35rem;
    color: var(--warm-gray);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .expand-icon {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: rgba(61, 43, 35, 0.82);
    color: #fff;
    font-family: 'Jost', sans-serif;
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1;
  }

  .portfolio-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: 3rem 0 0;
  }

  .portfolio-cta p {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-style: italic;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--rose);
    padding-bottom: 0.25rem;
    color: var(--deep);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lightbox {
    width: min(1120px, calc(100vw - 2rem));
    height: min(840px, calc(100vh - 2rem));
    border: 0;
    padding: 0;
    overflow: hidden;
    background: #2b211d;
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgba(22, 16, 13, 0.88);
    backdrop-filter: blur(8px);
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) 60px;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
  }

  .lightbox figure {
    height: calc(100% - 3rem);
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.8rem;
    margin: 1.5rem 0;
    padding: 0.8rem 0.8rem 1rem;
    background: #fffdfa;
    color: var(--deep);
    box-sizing: border-box;
    transform: rotate(-0.35deg);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.3);
  }

  .lightbox img {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: block;
    object-fit: contain;
    background: #eadfd7;
  }

  .lightbox figcaption { text-align: center; }
  .lightbox figcaption strong,
  .lightbox figcaption span { display: block; }

  .lightbox figcaption strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 400;
  }

  .lightbox figcaption span {
    margin-top: 0.25rem;
    color: var(--warm-gray);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lightbox-close,
  .lightbox-nav {
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .lightbox-close {
    position: absolute;
    z-index: 2;
    top: 0.65rem;
    right: 0.8rem;
    padding: 0.5rem;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-nav { align-self: stretch; font-size: 1.4rem; }

  .lightbox button:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: -4px;
  }

  :global(body.lightbox-open) { overflow: hidden; }

  @media (max-width: 800px) {
    .portfolio { padding: 2rem 1.25rem 4rem; }
    .portfolio-intro { padding-bottom: 2.5rem; }
    .back-link { margin-bottom: 2.5rem; }
    .intro-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .gallery-note { text-align: left; }

    .lookbook {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem 0.9rem;
      margin-inline: -1.25rem;
      padding: 1.75rem 1rem 0.25rem;
    }

    .look { padding: 0.45rem 0.45rem 0.55rem; }
    .look-caption { min-height: 36px; padding: 0.55rem 0.1rem 0; }
    .look-caption strong { font-size: 1.05rem; }
    .look-caption span { font-size: 0.47rem; letter-spacing: 0.1em; }
    .expand-icon { right: 0.4rem; bottom: 0.4rem; width: 26px; height: 26px; }
    .portfolio-cta { align-items: flex-start; flex-direction: column; }
    .lightbox[open] { grid-template-columns: 42px minmax(0, 1fr) 42px; }
    .lightbox figure {
      width: fit-content;
      max-width: 100%;
      height: auto;
      max-height: calc(100% - 4rem);
      grid-template-rows: auto auto;
      justify-self: center;
      margin: 2rem 0;
      padding: 0.55rem 0.55rem 0.8rem;
    }

    .lightbox img {
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: calc(100vh - 10rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .look-wrap,
    .look,
    .look-image { transition: none; }
  }
</style>
