---
/**
 * Nav component
 * Single Responsibility: Display main navigation menu
 */
import { NAVIGATION_LINKS } from '../config/constants';

interface Props {
    variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class:list={['header-nav', variant]} aria-label="Main navigation">
    {NAVIGATION_LINKS.map((link) => (
        <a
            href={link.href}
            class:list={[
                'nav-link',
                { active: !('external' in link) && currentPath === link.href },
            ]}
            {...('external' in link && link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
            {link.label}
        </a>
    ))}
</nav>

<style>
    .header-nav {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .header-nav.mobile {
        display: none;
    }

    .nav-link {
        font-family: 'Jost', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 400;
        color: var(--warm-gray);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .nav-link:hover {
        color: var(--deep);
    }

    .nav-link.active {
        color: var(--deep);
    }

    @media (max-width: 768px) {
        .header-nav {
            gap: 1.25rem;
        }

        .nav-link {
            font-size: 0.65rem;
        }
    }

    @media (max-width: 500px) {
        .header-nav.desktop {
            display: none;
        }

        .header-nav.mobile {
            position: absolute;
            top: calc(100% + 0.75rem);
            right: 0;
            display: flex;
            width: min(240px, calc(100vw - 2rem));
            padding: 1rem;
            box-sizing: border-box;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            background: var(--cream);
            border: 1px solid var(--blush);
            box-shadow: 0 12px 30px rgba(61, 43, 35, 0.15);
        }

        .header-nav.mobile .nav-link {
            padding: 0.75rem;
        }
    }
</style>
