{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/products",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.glowsalonwestclay.com"
        }
      ],
      "destination": "https://glowsalonwestclay.com/:path*",
      "permanent": true
    }
  ]
}
